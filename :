// 1. Compile the local file directly into the WebAssembly binary.
// Path is relative to this source file (.rs).
const ROM_BINARY_DATA: &[u8] = include_bytes!("../Super_mario_bros.nes");

#[component]
fn GameCanvas() -> impl IntoView {
    // 1. Define dimensions
    let native_width = 256;
    let native_height = 240;

    // 1.1. Scale factor
    let scale = 2;
    let display_width = native_width * scale; // 768px
    let display_height = native_height * scale; // 720px

    // 2. Create a reference for the canvas element
    let canvas_ref = NodeRef::<leptos::html::Canvas>::new();

    //emulator init
    log!("Loading emulator now");
    let mut emulator = virtual_nes::Emulator::new_with_gamecodes(ROM_BINARY_DATA.to_vec());
    virtual_nes::Interface::reset(&mut emulator);
    log!("Canvas done load binary games");

    log!("Rendering canvas for the first time");

    // 3. Render logic using a RenderEffect (or mounted lifecycle)
    // We wait until the DOM node is ready before initializing the canvas
    let _ = Effect::new(move |_| {
        if let Some(canvas) = canvas_ref.get() {
            let canvas: HtmlCanvasElement = canvas.unchecked_into();
            let context: CanvasRenderingContext2d =
                canvas.get_context("2d").unwrap().unwrap().unchecked_into();

            // Allocate buffer strictly for the internal size (256 * 240 * 4)
            let mut pixel_buffer = vec![0u8; native_width * native_height * 4];

            // Example: Fill the buffer with a color gradient
            for y in 0..native_height {
                for x in 0..native_width {
                    let index = (y * native_width + x) * 4;

                    // Render raw color gradients directly onto every pixel
                    pixel_buffer[index] = x as u8; // R
                    pixel_buffer[index + 1] = y as u8; // G
                    pixel_buffer[index + 2] = 50; // B
                    pixel_buffer[index + 3] = 255; // A (Alpha must be fully opaque)
                }
            }

            // Create ImageData and render onto the canvas
            let image_data = ImageData::new_with_u8_clamped_array_and_sh(
                Clamped(&pixel_buffer),
                native_width as u32,
                native_height as u32,
            )
            .unwrap();

            context.put_image_data(&image_data, 0.0, 0.0).unwrap();
            log!("Canvas component initialized!");
        }
    });

    let mut frame = Frame::new();
    virtual_nes::Interface::run_with_callback(&mut emulator, move |emulator| {
        // if !emulator.ppu_state.frame_completed {
        //     return;
        // }

        log!("Emulator run_with_callback");
        // render::render(&mut emulator.ppu_state, &mut frame);
        // emulator.ppu_state.frame_completed = false;
    });
    view! {
    <div style="display: flex; justify-content: center; align-items: center; background: #111; padding: 20px;">
                <canvas
                    node_ref=canvas_ref
                    width=native_width
                    height=native_height
                    style=format!(
                        "width: {}px; height: {}px; image-rendering: pixelated; image-rendering: crisp-edges; border: 4px solid #333;",
                        display_width,
                        display_height
                    )
                />
            </div>
        }
}
